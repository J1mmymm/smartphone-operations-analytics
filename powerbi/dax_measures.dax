-- Smartphone Operations Analytics: DAX measures

-- 销售订单净额；与经营流水中的销售回款控制总额对账。
MEASURE '_Measures'[Total Sales] = SUM(fact_sales_order[net_sales])
-- Format: ¥#,##0

-- 净销售额减销售成本。
MEASURE '_Measures'[Gross Profit] = SUM(fact_sales_order[gross_profit])
-- Format: ¥#,##0

-- 毛利额占净销售额的比例。
MEASURE '_Measures'[Gross Margin] = DIVIDE([Gross Profit], [Total Sales])
-- Format: 0.00%

-- 已发货订单的销售成本。
MEASURE '_Measures'[COGS] = SUM(fact_sales_order[cogs])
-- Format: ¥#,##0

-- 客户下单数量。
MEASURE '_Measures'[Ordered Units] = SUM(fact_sales_order[ordered_qty])
-- Format: #,##0

-- 实际发货数量。
MEASURE '_Measures'[Shipped Units] = SUM(fact_sales_order[shipped_qty])
-- Format: #,##0

-- 发货数量除以下单数量。
MEASURE '_Measures'[Fill Rate] = DIVIDE([Shipped Units], [Ordered Units])
-- Format: 0.00%

-- 按订单口径计算的承诺期内交付率。
MEASURE '_Measures'[On-time Order Rate] = DIVIDE(SUM(fact_sales_order[on_time_flag]), COUNTROWS(fact_sales_order))
-- Format: 0.00%

-- 订单从下单到发货的平均天数。
MEASURE '_Measures'[Average Delivery Days] = AVERAGE(fact_sales_order[delivery_days])
-- Format: 0.0

-- 净销售额除以发货数量。
MEASURE '_Measures'[Average Selling Price] = DIVIDE([Total Sales], [Shipped Units])
-- Format: ¥#,##0

-- 良品与不良品合计的实际投产数量。
MEASURE '_Measures'[Produced Units] = SUM(fact_production[actual_good_units]) + SUM(fact_production[defect_units])
-- Format: #,##0

-- 可用产能分配数量。
MEASURE '_Measures'[Capacity Units] = SUM(fact_production[capacity_allocated_units])
-- Format: #,##0

-- 实际投产数量除以分配产能。
MEASURE '_Measures'[Capacity Utilization] = DIVIDE([Produced Units], [Capacity Units])
-- Format: 0.00%

-- 当前筛选范围最后一个月的期末库存快照。
MEASURE '_Measures'[Ending Inventory] = VAR LastMonth = MAX(dim_date[date_key]) RETURN CALCULATE(SUM(fact_inventory[ending_inventory_qty]), dim_date[date_key] = LastMonth)
-- Format: #,##0

-- 当前筛选范围最后一个月的库存金额快照。
MEASURE '_Measures'[Inventory Value] = VAR LastMonth = MAX(dim_date[date_key]) RETURN CALCULATE(SUM(fact_inventory[inventory_value]), dim_date[date_key] = LastMonth)
-- Format: ¥#,##0

-- 当前筛选范围最后一个月、所选SKU的平均库存覆盖天数。
MEASURE '_Measures'[Days of Supply] = VAR LastMonth = MAX(dim_date[date_key]) RETURN CALCULATE(AVERAGE(fact_inventory[days_of_supply]), dim_date[date_key] = LastMonth)
-- Format: 0.0

-- 需求超过可供货量形成的缺货数量。
MEASURE '_Measures'[Stockout Units] = SUM(fact_inventory[stockout_qty])
-- Format: #,##0

-- 销售成本除以月末库存金额平均值。
MEASURE '_Measures'[Inventory Turnover] = DIVIDE([COGS], AVERAGEX(VALUES(dim_date[date_key]), CALCULATE(SUM(fact_inventory[inventory_value]))))
-- Format: 0.00x

-- 现金流入金额。
MEASURE '_Measures'[Cash Inflow] = CALCULATE(SUM(fact_cashflow[amount]), fact_cashflow[flow_direction] = "Inflow")
-- Format: ¥#,##0

-- 现金流出金额，按正数展示。
MEASURE '_Measures'[Cash Outflow] = CALCULATE(SUM(fact_cashflow[amount]), fact_cashflow[flow_direction] = "Outflow")
-- Format: ¥#,##0

-- 现金流入减现金流出。
MEASURE '_Measures'[Net Cashflow] = SUM(fact_cashflow[signed_amount])
-- Format: ¥#,##0;[Red]-¥#,##0

-- 从首月累计至当前筛选末月的现金余额。
MEASURE '_Measures'[Closing Cash] = VAR LastMonth = MAX(dim_date[date_key]) RETURN CALCULATE([Net Cashflow], FILTER(ALL(dim_date), dim_date[date_key] <= LastMonth))
-- Format: ¥#,##0

-- 当前经营季度相对上一经营季度的销售额增速。
MEASURE '_Measures'[Sales QoQ] = VAR CurrentQuarter = MAX(dim_date[quarter_seq]) VAR PreviousSales = CALCULATE([Total Sales], FILTER(ALL(dim_date), dim_date[quarter_seq] = CurrentQuarter - 1)) RETURN DIVIDE([Total Sales] - PreviousSales, PreviousSales)
-- Format: 0.00%
